<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="unqualified" attributeFormDefault="unqualified">

	<xs:element name="Ordini">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="HEADER" minOccurs="1" maxOccurs="unbounded"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	
	<xs:element name="HEADER">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="ID_ORDINE_PVM" type="idOrdPvm"/>
				<xs:element name="DATA_DRO" type="xs:date"/>
				<xs:element name="CODE_CAUS" type="codeCaus"/>
				<xs:choice>
					<xs:element ref="ACCESSO"/>
				</xs:choice>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ACCESSO">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="TIPO_CONTR" type="enumTipoContr"/>
				<xs:element name="CODE_CONTR" type="xs:integer"/>
				<xs:element name="ID_RISORSA" type="idRis"/>
				<xs:element name="TIPO_AZIONE" type ="enumTipoAzione"/>
				<xs:element name="BANDA_UP" type="xs:integer"/>
				<xs:element name="BANDA_DOWN" type="xs:integer"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:simpleType name="idOrdPvm">
		<xs:restriction base="strBase">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="idRis">
		<xs:restriction base="strBase">
			<xs:minLength value="1"/>
			<xs:maxLength value="20"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="strBase">
		<xs:restriction base="xs:string">
			<xs:whiteSpace value="preserve"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="codeCaus">
		<xs:restriction base="strBase">
			<xs:minLength value="1"/>
			<xs:maxLength value="2"/>
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumTipoContr">
		<xs:restriction base="strBase">
			<xs:enumeration value="50"/>	<!-- BTS NGA -->
			<xs:enumeration value="51"/>	<!-- VULA -->
			<xs:enumeration value="60"/>	<!-- EASYIP NGA -->
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="enumTipoAzione">
		<xs:restriction base="strBase">
			<xs:enumeration value="1"/>    <!-- ATTIVAZIONE -->
			<xs:enumeration value="2"/>    <!-- CESSAZIONE -->
			<xs:enumeration value="3"/>    <!-- VARIAZIONE -->
		</xs:restriction>
	</xs:simpleType>
</xs:schema>
